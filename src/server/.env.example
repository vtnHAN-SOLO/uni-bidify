# ============================================
# AuctionHub Server Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Application
APP_NAME=AuctionHub
PORT=3000
CLIENT_URL=http://localhost:8080

# MongoDB
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auctionhub?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_LIFE=7d

# reCAPTCHA secret key
RECAPTCHA_SECRET_KEY=

# SMTP Email Configuration
# Gmail example (requires App Password, not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=AuctionHub <noreply@auctionhub.com>


